{
  // 静的ファイル（public/）と、記録の受け口（worker/index.js）を1つのWorkerで出す。
  // public/ にあるファイルは Assets がそのまま返し、
  // それ以外（/api/records など）だけが worker/index.js に来る。
  "name": "reccheck",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // 記録の置き場（Cloudflare D1）。
  // 初めてのデプロイで wrangler が「reccheck」という名前で自動で作ったデータベースの ID。
  // ID を書いておくと、Worker を作り直しても空の別のデータベースが作られず、今の記録に繋がり続ける。
  // データベースを作り直したときは、ここの database_id を新しいものに差し替える。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reccheck",
      "database_id": "e1706e96-6217-4d4b-bfb2-474a9381e387"
    }
  ],

  // デプロイ時に reccheck.40hzp.com を自動でこのWorkerに割り当てる
  "routes": [
    { "pattern": "reccheck.40hzp.com", "custom_domain": true }
  ],

  // main 以外のブランチ（PR）は、Cloudflare が `npx wrangler preview` で
  // 試し用の URL に出す。そのコマンドはこのブロックが無いと止まる。
  // 中を空にしているので、試し用の URL には D1 が繋がらない
  // （本番の記録に試しのデータが混ざらない。記録は 503 で断られる）。
  "previews": {}

  // TURNSTILE_SECRET_KEY は secret として Cloudflare の画面で登録する。ここには書かない。
}
